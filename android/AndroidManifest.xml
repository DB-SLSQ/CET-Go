<?xml version="1.0" encoding="utf-8"?>
<!--
  CET Go 安卓外壳

  刻意不依赖 androidx：整个应用只有一个 Activity 加一个 WebView，
  用框架自带的 API 就够了。这样构建只需要
  javac / d8 / aapt2 / zipalign / apksigner 五步，
  不用拉 Gradle 和一堆 maven 依赖。

  注意：XML 注释里不能出现连续两个减号，写分隔线会让 aapt2 报
  "not well-formed (invalid token)"。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cetgo.app"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- 全程离线：不申请任何权限，包括网络。
         页面是 App 自己从 assets 里喂给 WebView 的（见 MainActivity 的 shouldInterceptRequest）。 -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:hardwareAccelerated="true"
        android:allowBackup="true"
        android:supportsRtl="false"
        android:enableOnBackInvokedCallback="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name="com.cetgo.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
