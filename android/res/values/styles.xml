<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      主题配色跟游戏界面保持一致：奶白底 + 樱花粉点缀。
      windowLightStatusBar 让状态栏图标变深色（API 23+，本项目 minSdk 24 起，够用）。
      导航栏反过来用深色 + 系统默认的浅色图标，省掉 API 27 才有的
      windowLightNavigationBar 属性，免得在老机器上出现「白底白图标」。
    -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#fdf4ee</item>
        <item name="android:colorBackground">#fdf4ee</item>
        <item name="android:statusBarColor">#fdf4ee</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#4c3542</item>
        <item name="android:colorAccent">#ff8fab</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
